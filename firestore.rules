rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isCefrLevel(lvl) {
      return lvl in ['A1', 'A2', 'B1', 'B2', 'C1'];
    }

    function isValidUserLearningProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.preferredLevel is string && isCefrLevel(data.preferredLevel) &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 100000 &&
             data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 100000 &&
             data.lastActiveDay is string && data.lastActiveDay.size() <= 20 &&
             data.totalStudyMinutes is int && data.totalStudyMinutes >= 0 &&
             data.wordsMasteredCount is int && data.wordsMasteredCount >= 0 && data.wordsMasteredCount <= 10000 &&
             data.wordsLearningCount is int && data.wordsLearningCount >= 0 && data.wordsLearningCount <= 10000 &&
             data.quizzesCompleted is int && data.quizzesCompleted >= 0 &&
             data.totalQuizScorePct is int && data.totalQuizScorePct >= 0 &&
             data.storiesCompleted is int && data.storiesCompleted >= 0 && data.storiesCompleted <= 1000 &&
             data.conversationsCompleted is int && data.conversationsCompleted >= 0 && data.conversationsCompleted <= 1000 &&
             data.grammarCompleted is int && data.grammarCompleted >= 0 && data.grammarCompleted <= 500 &&
             data.verbsPracticed is int && data.verbsPracticed >= 0 && data.verbsPracticed <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWordProgress(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.headword is string && data.headword.size() >= 1 && data.headword.size() <= 100 &&
             data.cefrLevel is string && isCefrLevel(data.cefrLevel) &&
             data.favorite is bool &&
             data.masteryState is string && data.masteryState in ['NEW', 'LEARNING', 'REVIEWING', 'MASTERED'] &&
             data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0 &&
             data.intervalDays is int && data.intervalDays >= 0 && data.intervalDays <= 3650 &&
             data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 10000 &&
             data.nextReviewAtMs is int && data.nextReviewAtMs >= 0 &&
             data.correctCount is int && data.correctCount >= 0 &&
             data.attemptCount is int && data.attemptCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuizAttempt(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.category is string && data.category in ['VOCABULARY', 'GRAMMAR', 'STORY', 'CONVERSATION'] &&
             data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 50 &&
             data.difficulty is string && data.difficulty in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED'] &&
             data.cefrLevel is string && data.cefrLevel in ['A1', 'A2', 'B1', 'B2', 'C1', 'ALL'] &&
             data.score is int && data.score >= 0 && data.score <= data.totalQuestions &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 160 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidContentProgress(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.contentType is string && data.contentType in ['GRAMMAR', 'STORY', 'CONVERSATION', 'VERB'] &&
             data.cefrLevel is string && isCefrLevel(data.cefrLevel) &&
             data.completed is bool &&
             data.bestScorePct is int && data.bestScorePct >= 0 && data.bestScorePct <= 100 &&
             data.minutesSpent is int && data.minutesSpent >= 0 && data.minutesSpent <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyActivity(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 16 &&
             data.minutesStudied is int && data.minutesStudied >= 0 && data.minutesStudied <= 1440 &&
             data.wordsReviewed is int && data.wordsReviewed >= 0 && data.wordsReviewed <= 50000 &&
             data.quizzesTaken is int && data.quizzesTaken >= 0 && data.quizzesTaken <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredLevel', 'streakDays', 'longestStreak',
                         'lastActiveDay', 'totalStudyMinutes', 'wordsMasteredCount', 'wordsLearningCount',
                         'quizzesCompleted', 'totalQuizScorePct', 'storiesCompleted', 'conversationsCompleted',
                         'grammarCompleted', 'verbsPracticed', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'preferredLevel', 'streakDays', 'longestStreak',
                         'lastActiveDay', 'totalStudyMinutes', 'wordsMasteredCount', 'wordsLearningCount',
                         'quizzesCompleted', 'totalQuizScorePct', 'storiesCompleted', 'conversationsCompleted',
                         'grammarCompleted', 'verbsPracticed', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserLearningProfile(incoming(), userId);

      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserLearningProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'preferredLevel', 'streakDays', 'longestStreak',
                         'lastActiveDay', 'totalStudyMinutes', 'wordsMasteredCount', 'wordsLearningCount',
                         'quizzesCompleted', 'totalQuizScorePct', 'storiesCompleted', 'conversationsCompleted',
                         'grammarCompleted', 'verbsPracticed', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /word_progress/{wordId} {
        allow get: if isOwner(userId) && isValidId(wordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(wordId) &&
                         incoming().keys().hasAll([
                           'userId', 'headword', 'cefrLevel', 'favorite', 'masteryState',
                           'easeFactor', 'intervalDays', 'repetitions', 'nextReviewAtMs',
                           'correctCount', 'attemptCount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'headword', 'cefrLevel', 'favorite', 'masteryState',
                           'easeFactor', 'intervalDays', 'repetitions', 'nextReviewAtMs',
                           'correctCount', 'attemptCount', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidWordProgress(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(wordId) &&
                         incoming().userId == existing().userId &&
                         incoming().headword == existing().headword &&
                         incoming().createdAt == existing().createdAt &&
                         isValidWordProgress(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cefrLevel', 'favorite', 'masteryState', 'easeFactor', 'intervalDays',
                           'repetitions', 'nextReviewAtMs', 'correctCount', 'attemptCount', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(wordId);
      }

      match /quiz_attempts/{attemptId} {
        allow get: if isOwner(userId) && isValidId(attemptId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(attemptId) &&
                         incoming().keys().hasAll([
                           'userId', 'category', 'mode', 'difficulty', 'cefrLevel',
                           'score', 'totalQuestions', 'durationSeconds', 'topicTitle', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'category', 'mode', 'difficulty', 'cefrLevel',
                           'score', 'totalQuestions', 'durationSeconds', 'topicTitle', 'createdAt'
                         ]) &&
                         isValidQuizAttempt(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(attemptId);
      }

      match /content_progress/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(itemId) &&
                         incoming().keys().hasAll([
                           'userId', 'contentType', 'cefrLevel', 'completed',
                           'bestScorePct', 'minutesSpent', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'contentType', 'cefrLevel', 'completed',
                           'bestScorePct', 'minutesSpent', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidContentProgress(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(itemId) &&
                         incoming().userId == existing().userId &&
                         incoming().contentType == existing().contentType &&
                         incoming().createdAt == existing().createdAt &&
                         isValidContentProgress(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cefrLevel', 'completed', 'bestScorePct', 'minutesSpent', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /daily_activity/{dayId} {
        allow get: if isOwner(userId) && isValidId(dayId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(dayId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'minutesStudied', 'wordsReviewed',
                           'quizzesTaken', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'minutesStudied', 'wordsReviewed',
                           'quizzesTaken', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyActivity(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(dayId) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         isValidDailyActivity(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'minutesStudied', 'wordsReviewed', 'quizzesTaken', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(dayId);
      }
    }
  }
}
